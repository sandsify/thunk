# Copy to .env (chmod 600) and fill in. .env is not in git.

# The public name of this server, and the origin of the pages that use it
# (the block pages in the iframes, not Canvas).
SITE=thunk.cse.chalmers.se
PAGES_ORIGIN=https://www.cse.chalmers.se

# Hints: Gemini's free tier (a key from a Google project without billing).
GEMINI_API_KEY=
# Or a paid model, with a per-key credit limit at OpenRouter:
# HINT_PROVIDER=openrouter
# HINT_MODEL=anthropic/claude-haiku-5.5
# OPENROUTER_API_KEY=
# HINT_TOTAL_PER_DAY=500

# Per IP address and minute (a campus network may share one address).
SUBMIT_PER_MINUTE=120
HINT_PER_MINUTE=30
